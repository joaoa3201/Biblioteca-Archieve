DB_HOST=127.0.0.1
DB_NAME=biblioteca_archive
DB_USER=root
DB_PASS=

# Chatbot (assistente de IA) - opcional. Sem nenhuma chave, o assistente fica indisponível.
# Opção gratuita: crie uma chave do Google Gemini em https://aistudio.google.com/apikey
# NUNCA coloque chaves em arquivos JavaScript/HTML.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opção paga (alternativa): Anthropic Claude, em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Só se tiver as duas chaves e quiser forçar uma: gemini ou anthropic
IA_PROVEDOR=
